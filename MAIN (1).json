    {
      "parameters": {
        "jsCode": "const results = [];\n\n// Verileri önceki düğümün ne verdiğine bakmaksızın, doğrudan asıl kaynaklarından çekiyoruz\nconst output = $('Slide Üretme1').first().json.output || {};\nconst slides = output.slides || [];\nconst konuId = output.KonuId || \"0\";\nconst projeAdi = $('veri standartizasyonu4').first().json['ProjeAdı'] || \"VarsayilanProje\";\n\n// Her slaytı ayrı bir dosyaya dönüştürüyoruz\nfor (const slide of slides) {\n  const textContent = slide.content || \"\";\n  const slideId = slide.id || \"Slide\";\n\n  const buffer = Buffer.from(textContent, 'utf8');\n\n  results.push({\n    json: {\n      KonuId: konuId,\n      SlideId: slideId,\n      ProjeAdi: projeAdi\n    },\n    binary: {\n      data: {\n        data: buffer.toString('base64'),\n        mimeType: 'text/plain',\n        fileName: `Konu${konuId}_${slideId}.txt`\n      }\n    }\n  });\n}\n\nreturn results;"
      },
